          "name": "Project Name",
          "strategy": "human-readable unique project title"
        },
        "fields": [
          {
            "name": "Project Name",
            "type": "single_line_text",
            "required": true,
            "source": "native",
            "description": "Primary display name"
          },
          {
            "name": "Status",
            "type": "single_select",
            "required": true,
            "source": "native",
            "options": ["Draft", "Submitted", "In Review", "Approved", "Completed", "Canceled"],
            "description": "Project lifecycle state"
          },
          {
            "name": "Client",
            "type": "linked_record",
            "required": true,
            "source": "native",
            "description": "Linked client"
          }
        ]
      },
      {
        "name": "Clients",
        "purpose": "Store client master data.",
        "grain": "one record per client",
        "primary_field": {
          "name": "Client Name",
          "strategy": "client legal or operating name"
        },
        "fields": [
          {
            "name": "Client Name",
            "type": "single_line_text",
            "required": true,
            "source": "native",
            "description": "Client display name"
          }
        ]
      }
    ],
    "relationships": [
      {
        "from_table": "Projects",
